{
  "name": "wikipatrol",
  "version": "0.0.0",
  "private": true,
  "description": "What does an expensive model buy you on Wikipedia's edit feed, when you cannot afford to call it?",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "KAFKAJS_NO_PARTITIONER_WARNING=1 tsx src/ingest/main.ts",
    "phase0:rate": "tsx src/phase0/measure-rate.ts",
    "phase0:tags": "tsx src/phase0/probe-tags.ts",
    "phase0:sample": "tsx src/phase0/build-sample.ts",
    "phase0:noise": "tsx src/phase0/score-sample.ts",
    "test:kafka": "KAFKA_BROKERS=localhost:19092 vitest run",
    "phase3:table": "tsx src/phase3/build-table.ts",
    "phase3:evaluate": "tsx src/phase3/evaluate-filter.ts",
    "phase4:backfill-tags": "tsx src/phase4/backfill-tags.ts",
    "labeller": "KAFKAJS_NO_PARTITIONER_WARNING=1 tsx src/labels/main.ts",
    "phase4:validate": "tsx src/phase4/validate.ts",
    "phase4:summary": "tsx src/phase4/summary.ts",
    "phase5:set": "tsx src/phase5/build-set.ts",
    "phase5:run": "tsx --env-file-if-exists=.env src/phase5/run.ts",
    "phase5:score": "tsx src/phase5/score.ts",
    "phase5:resume": "tsx --env-file-if-exists=.env src/phase5/resume-all.ts",
    "phase6:calibration": "tsx src/phase6/calibration.ts",
    "pipeline": "KAFKAJS_NO_PARTITIONER_WARNING=1 tsx src/pipeline/main.ts",
    "phase2:backpressure": "tsx src/phase2/backpressure.ts",
    "classifier": "KAFKAJS_NO_PARTITIONER_WARNING=1 tsx --env-file-if-exists=.env src/classifier/main.ts",
    "phase9:drift": "tsx --env-file-if-exists=.env src/phase9/main.ts"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
